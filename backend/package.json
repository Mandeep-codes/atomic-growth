{
  "name": "@atomik-clips/backend",
  "version": "1.0.0",
  "description": "Backend for Frontend API using TypeScript, tRPC, and MySQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "postbuild": "npm run copy-share-card-assets",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "db:introspect": "drizzle-kit introspect",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "inngest:dev": "pnpm dlx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "share-card:qr": "ts-node --transpile-only src/scripts/generatePayoutShareCardWithQr.ts",
    "copy-share-card-assets": "node ./scripts/copyShareCardAssets.mjs"
  },
  "keywords": [
    "bff",
    "trpc",
    "typescript",
    "mysql",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@clerk/backend": "^2.17.1",
    "@clerk/express": "^1.7.37",
    "@inboundemail/sdk": "^4.4.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@trpc/server": "^10.45.0",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.6",
    "express": "^4.18.2",
    "googleapis": "^161.0.0",
    "inboundemail": "^0.20.0",
    "inngest": "^3.54.0",
    "mysql2": "^3.6.5",
    "openai": "^6.9.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "superjson": "^2.2.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.19",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.6.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
