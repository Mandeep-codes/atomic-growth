# ─────────────────────────────────────────────────────────────────────────────
# Backend environment — TEMPLATE
#
# Copy to .env for local work. On DigitalOcean these go in the app's
# Environment Variables panel, marked Encrypted — never in the repo.
#
# .env is gitignored. Keep it that way: it holds live credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──

# The CLONED database, not the live cluster. Pointing a second backend at the
# live one makes its six scheduled jobs run twice — including update-views,
# which creates reward money every four hours.
DATABASE_URL=mysql://user:password@host:25060/defaultdb

# Must match the frontend's deployed URL exactly, or the browser blocks every
# API call with a CORS error.
CORS_ORIGIN=https://your-frontend.ondigitalocean.app

CLERK_SECRET_KEY=

NODE_ENV=production
PORT=3000
RUN_MIGRATIONS=true

# ── Leave unset on a copy that holds cloned data ──
#
# The clone carries real clippers: their emails, Discord ids, and bank/Wise
# payout details. With these set, a test click can pay or message a real
# person. Set them only on the deployment that is genuinely live.

# WISE_API_TOKEN=
# WISE_PROFILE_ID=
# WISE_API_BASE_URL=
# INBOUND_API_KEY=

# ── Background jobs — decide deliberately ──
#
# Set these and the six scheduled jobs run against whatever DATABASE_URL points
# at. Leave them unset and the copy runs no jobs: views never refresh and
# rewards never accrue. Both are valid; pick on purpose.

# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

# ── Optional integrations ──
# Unset means the feature is simply unavailable, not broken.

# RAPIDAPI_KEY=
# YOUTUBE_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=

# Object storage for hosted clips and thumbnails.
# DO_SPACES_ACCESS_KEY_ID=
# DO_SPACES_SECRET_ACCESS_KEY=
# DO_SPACES_ENDPOINT=
# DO_SPACES_REGION=
# DO_SPACES_BUCKET=
# DO_SPACES_PUBLIC_URL=

# ── NEVER set these on a deployed app ──
#
# LOCAL_DEV_NO_AUTH=true turns login off completely — anyone who opens the URL
# is signed in as a user. It exists so the app can run locally with no Clerk
# credentials. On a deployment it is an open door.
#
# LOCAL_DEV_NO_AUTH=
# LOCAL_DEV_ROLES=
